<Window x:Class="ReleaseChecker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:ReleaseChecker"
    mc:Ignorable="d"
    Title="MainWindow" Height="700" Width="1000">
    <Grid AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
        <StackPanel Margin="12">
            <TextBlock Text="Drop a folder here" FontSize="16" Margin="0,0,0,8"/>
            <DataGrid x:Name="FilesDataGrid" Height="560" AutoGenerateColumns="False" IsReadOnly="True"/>
        </StackPanel>
    </Grid>
</Window>
