<Window x:Class="ReleaseChecker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:ReleaseChecker"
    mc:Ignorable="d"
    Title="MainWindow" Height="700" Width="1000" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen" MinWidth="900" MinHeight="600">
    <Grid AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Drop a folder here" FontSize="16" Margin="0,0,0,8" Grid.Row="0"/>
            <DataGrid x:Name="FilesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" Grid.Row="1" VerticalAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>
