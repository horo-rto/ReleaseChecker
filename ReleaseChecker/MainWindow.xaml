<Window x:Class="ReleaseChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReleaseChecker"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
        <StackPanel Margin="12">
            <TextBlock Text="Drop one or more folders here" FontSize="16" Margin="0,0,0,8"/>
            <ListBox x:Name="FoldersListBox" Height="300"/>
        </StackPanel>
    </Grid>
</Window>
